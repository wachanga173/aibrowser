{
  "manifest_version": 3,
  "name": "Privacy AI Browser Guard",
  "version": "1.0.0",
  "description": "Local-first privacy engine with ad/tracker blocking, fingerprinting defense, and local zero-telemetry architecture.",
  "update_url": "https://raw.githubusercontent.com/wachanga173/aibrowser/main/updates.xml",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/ui/popup/index.html",
    "default_title": "Privacy AI Guard Status"
  },
  "options_ui": {
    "page": "src/ui/options/index.html",
    "open_in_tab": true
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_default",
        "enabled": true,
        "path": "rules/ruleset_default.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-scripts/main-world.js"],
      "run_at": "document_start",
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content-scripts/index.js"],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/wasm/*", "design-system/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
