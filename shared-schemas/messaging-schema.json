{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NativeMessagingProtocol",
  "description": "Shared schema for messaging between Extension and Native Host companion process",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "type": "string",
      "enum": ["ping", "pong", "extract_dom", "extracted_content", "vector_search", "error"]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": ["version", "type", "payload"]
}
